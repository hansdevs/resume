// Cloudflare Workers config: an assets-only Worker serving the portfolio
// as static files from the repo root. The name must stay "resume" to match
// the Worker created in the dashboard.
// Cloudflare Test Deploy 08.05.2026
{
  "name": "resume",
  "compatibility_date": "2026-08-05",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  }
}
